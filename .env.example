ASSISTANT_DATA_DIR=data
# Supported offline providers: stub, template. Neither requires an API key.
LLM_PROVIDER=stub
# Placeholder only; never commit .env or real credentials.
LLM_API_KEY=
CREDIT_RATE_VND=450000
RETAKE_MULTIPLIER=1.5
MAX_CREDITS=30
LOG_LEVEL=INFO
# Lab04: local demo placeholder; use your own key in .env.
API_ADMIN_KEY=change-me
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Timeout per attempt; one retry means at most two HTTP attempts.
WEATHER_TIMEOUT_S=3
WEATHER_RETRIES=1
WEATHER_CACHE_TTL_S=600
CAMPUS_LAT=10.7626
CAMPUS_LON=106.6822
# Reserved for the optional rate-limit exercise.
RATE_LIMIT_PER_MIN=30

# Set a private, stable salt before storing real sessions.
DATABASE_URL=sqlite:///assistant.db
SESSION_SALT=replace-with-a-private-stable-salt
